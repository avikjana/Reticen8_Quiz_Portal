# Copy to backend/.env and fill in. Never commit the real .env.

PORT=5000

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login lasts, in seconds (default 7 days)
JWT_EXPIRES_IN_SECONDS=604800

# Frontend origin(s) allowed to call the API (comma-separated)
CLIENT_ORIGIN=http://localhost:5173

# Google OAuth "Web application" client ID from Google Cloud Console
# (APIs & Services -> Credentials). Must match VITE_GOOGLE_CLIENT_ID in the frontend.
GOOGLE_CLIENT_ID=

# Optional: only allow Google accounts from these domains (comma-separated), e.g. reticen8.com
GOOGLE_ALLOWED_DOMAINS=

# Set to true only when running behind a reverse proxy (nginx, a load balancer)
TRUST_PROXY=false
