# Copy to backend/.env and fill in. Never commit the real .env.

PORT=5000

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production; in dev a random one is used if unset (logs everyone
# out on every restart).
JWT_SECRET=

# How long a login lasts, in seconds (default 7 days)
JWT_EXPIRES_IN_SECONDS=604800

# Frontend origin(s) allowed to call the API (comma-separated). Also used as the
# base for password-reset links.
CLIENT_ORIGIN=http://localhost:5173

# Google OAuth "Web application" client ID (APIs & Services -> Credentials).
# Must match VITE_GOOGLE_CLIENT_ID in the frontend.
GOOGLE_CLIENT_ID=

# Optional: only allow Google accounts from these domains (comma-separated)
GOOGLE_ALLOWED_DOMAINS=

# Set to true only when running behind a reverse proxy (nginx, a load balancer)
TRUST_PROXY=false

# SQLite database file. Defaults to backend/src/data/reticen8.db, which is
# generated and git-ignored (seeded from the *.json files on first run).
# DB_PATH=./src/data/reticen8.db

# Email delivery. With no provider set, password-reset emails are printed to the
# server console in development instead of being sent. Wire a real provider in
# backend/src/utils/email.js and set MAIL_PROVIDER + MAIL_FROM to send for real.
# MAIL_PROVIDER=
# MAIL_FROM=Reticen8 Academy <no-reply@reticen8.com>

# Set LOG_LEVEL=silent to turn off request logging (used by the test suite)
# LOG_LEVEL=
